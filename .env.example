POSTGRES_USER=aurelia
# Letters and digits only: the password is placed inside a connection URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aurelia

# DATABASE_URL is built from the three values above in docker-compose.yml.
REDIS_URL=redis://redis:6379/0

# Where tools and nodes reach the orchestrator (internal network)
ORCHESTRATOR_URL=http://orchestrator:8000

# Hot-reloaded runtime config
CONFIG_PATH=/config/aurelia.yaml
GOVERNANCE_PATH=/config/governance

# Language models (Phase 1). Use a key with a low spend limit while testing.
ANTHROPIC_API_KEY=

# ---- Chrysalis (home server only) ------------------------------------------
# Turns on the update system. Leave unset on dev machines.
# COMPOSE_PROFILES=chrysalis
# Absolute path of this repo on the server, e.g. /home/kentrell/aurelia
# AURELIA_ROOT=
# Your user and group ids, and the docker group id:  id -u ; id -g ; getent group docker | cut -d: -f3
# AURELIA_UID=1000
# AURELIA_GID=1000
# DOCKER_GID=999
# Read-only GitHub deploy key for this repo, e.g. /home/kentrell/.ssh/aurelia_deploy
# DEPLOY_KEY_PATH=
